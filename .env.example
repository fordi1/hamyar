# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Liara console -> API -> create key
LIARA_API_TOKEN=

# Only if you work inside a Liara team (console -> API shows the team ID)
LIARA_TEAM_ID=

# Optional override
LIARA_API_BASE=https://api.liara.ir

# Liara AI. Either an AI API key + base URL (https://ai.liara.ir/api/<workspaceID>/v1),
# or only the workspace ID: then the console token above is used on the playground endpoint.
LIARA_AI_API_KEY=
LIARA_AI_BASE_URL=
LIARA_AI_WORKSPACE_ID=
LIARA_AI_MODEL=

# CodeCraft API (OpenAI-compatible). The model must support tool calling.
# Keep the real key only in `.env`; never commit or show it in the dashboard.
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
CODECRAFT_MODEL=gpt-5.6-sol
CODECRAFT_REASONING_EFFORT=none

# Or any other OpenAI-compatible provider, used when the options above are not configured.
# AI_REASONING_EFFORT=none is needed by reasoning models that reject tool calls otherwise.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REASONING_EFFORT=

# Required when the dashboard runs on a server; without it, it only listens on 127.0.0.1
HAMYAR_DASHBOARD_PASSWORD=

# observe | review | auto-safe
HAMYAR_MODE=review
